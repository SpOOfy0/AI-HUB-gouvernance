# =============================================================================
# RDT AI Hub - variables d'environnement (copier en .env). AUCUNE vraie valeur ici.
# =============================================================================

# --- Mode démo -----------------------------------------------------------------
# true : les fournisseurs externes sont simulés (MockProvider). Aucune requête ne
# part vers OpenAI / Anthropic / DeepSeek. Classification, routage, quotas et audit
# restent réels. Les comptes de démo sont affichés sur la page de connexion.
DEMO_MODE=true

# --- Base de données -------------------------------------------------------------
POSTGRES_USER=rdt
POSTGRES_PASSWORD=rdt
POSTGRES_DB=rdt_ai_hub

# --- Authentification ------------------------------------------------------------
# Secret de signature des JWT. En production : 32+ caractères aléatoires, gérés par un coffre.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Cookie Secure (HTTPS uniquement). Chrome et Firefox l'acceptent sur http://localhost.
# Safari ne l'accepte pas sur http://localhost : mettre false pour une démo locale sous Safari.
COOKIE_SECURE=true

# --- Clés fournisseurs (utilisées seulement si DEMO_MODE=false) --------------------
# Lues uniquement par le backend. Jamais renvoyées par l'API (l'interface affiche
# "configurée" / "non configurée").
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Ollama (modèles privés) -------------------------------------------------------
# Profil compose "ollama" : http://ollama:11434
# Ollama installé sur le poste hôte : http://host.docker.internal:11434
# Si Ollama est injoignable, un mock "privé" prend le relais (indiqué dans l'interface).
OLLAMA_BASE_URL=http://ollama:11434

# --- Démonstration du fallback ------------------------------------------------------
# Modèles (nom LiteLLM) que le fournisseur simulé fait échouer, séparés par des virgules.
# Exemple : MOCK_FAILING_MODELS=deepseek/deepseek-chat
MOCK_FAILING_MODELS=

# --- Limitation de débit (requêtes par minute) ---------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30
